&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-bash&#34; data-lang=&#34;bash&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;$ git config global user.name &lt;span class=&#34;s2&#34;&gt;&amp;#34;xushankun&amp;#34;&lt;/span&gt;
